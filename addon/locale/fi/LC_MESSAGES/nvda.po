#: addon\globalPlugins\instantTranslate\__init__.py:142
msgid ""
"Instant Translate layer commands. Then press h to list available commands."
msgstr ""
"Pikakääntäjän komentokerroskomennot. Saat luettelon käytettävissä olevista "
"komennoista painamalla H."

#. Translators: message presented in input help mode, when user presses the shortcut keys for this addon.
#: addon\globalPlugins\instantTranslate\__init__.py:160
msgid ""
"Translates clipboard text from one language to another using Google "
"Translate."
msgstr ""
"Kääntää leikepöydällä olevan tekstin kieleltä toiselle Google-kääntäjää "
"käyttäen."

#. Translators: message presented when user presses the shortcut key for translating clipboard text but the clipboard is empty.
#: addon\globalPlugins\instantTranslate\__init__.py:170
msgid "There is no text on the clipboard"
msgstr "Leikepöydällä ei ole tekstiä"

#. Translators: message presented in input help mode, when user presses the shortcut keys for this addon.
#: addon\globalPlugins\instantTranslate\__init__.py:185
msgid ""
"Translates selected text from one language to another using Google Translate."
msgstr "Kääntää valitun tekstin kieleltä toiselle Google-kääntäjää käyttäen."

#. Translators: user has pressed the shortcut key for translating selected text, but no text was actually selected.
#: addon\globalPlugins\instantTranslate\__init__.py:192
#: addon\globalPlugins\instantTranslate\__init__.py:310
msgid "no selection"
msgstr "Ei valintaa"

#: addon\globalPlugins\instantTranslate\__init__.py:240
msgid "Translation failed"
msgstr "Käännös epäonnistui"

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:255
msgid "It swaps source and target languages."
msgstr "Vaihtaa lähde- ja kohdekielet keskenään."

#. Translators: message presented to announce that the source and target languages have been swapped.
#: addon\globalPlugins\instantTranslate\__init__.py:267
msgid "Languages swapped"
msgstr "Kielet vaihdettu"

#. Translators: message presented to announce the current source and target languages.
#: addon\globalPlugins\instantTranslate\__init__.py:269
#: addon\globalPlugins\instantTranslate\__init__.py:286
#, python-brace-format
msgid "Translate: from {lang1} to {lang2}"
msgstr "Käännä kielestä {lang1} kielelle {lang2}"

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:281
msgid "It announces the current source and target languages."
msgstr "Ilmoittaa nykyisen lähde- ja kohdekielen."

#. Translators: message presented to announce a successful copy
#: addon\globalPlugins\instantTranslate\__init__.py:294
msgid "Last translation copied in clipboard"
msgstr "Viimeisin käännös kopioitu leikepöydälle"

#. Translators: message presented to announce no previous translation disponibility
#: addon\globalPlugins\instantTranslate\__init__.py:297
msgid "No stored translation"
msgstr "Ei tallennettua käännöstä"

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:299
msgid "It copies the last translation to clipboard"
msgstr "Kopioi viimeisimmän käännöksen leikepöydälle"

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:303
msgid "It identifies the language of selected text"
msgstr "Tunnistaa valitun tekstin kielen"

#: addon\globalPlugins\instantTranslate\__init__.py:313
msgid "Language is..."
msgstr "Kieli on..."

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:353
msgid "It translates the last spoken text"
msgstr "Kääntää viimeksi puhutun tekstin"

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:362
msgid "Announces all available layered commands"
msgstr "Puhuu kaikki komentokerroksen komennot"

#: addon\globalPlugins\instantTranslate\__init__.py:366
msgid ""
"t translates selected text, shift+t translates clipboard text, a announces "
"current swap configuration, s swaps source and target languages, c copies "
"last result to clipboard, i identify the language of selected text, l "
"translates last spoken text, o open translation settings dialog, v toggles "
"automatic translation, h displays this message."
msgstr ""
"T kääntää valitun tekstin, Vaihto+T kääntää leikepöydällä olevan tekstin, A "
"ilmoittaa nykyisen kielenvaihtoasetuksen, S vaihtaa lähde- ja kohdekielet "
"keskenään, C kopioi viimeisimmän käännöksen leikepöydälle, I tunnistaa "
"valitun tekstin kielen, L kääntää viimeksi puhutun tekstin, O avaa "
"käännösasetusten valintaikkunan, V ottaa käyttöön automaattisen käännöksen "
"tai poistaa sen käytöstä, H näyttää tämän ohjeen."

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:370
msgid "Opens Instant Translate settings dialog."
msgstr "Avaa Pikakääntäjän asetusvalintaikkunan."

#. Translators: Presented in input help mode.
#: addon\globalPlugins\instantTranslate\__init__.py:383
msgid "Toggle automatic translation of speech output."
msgstr ""
"Ota käyttöön automaattinen puhetulosteen kääntäminen tai poista se käytöstä."

#. Translators: message presented to announce that automatic translation is enabled.
#: addon\globalPlugins\instantTranslate\__init__.py:389
msgid "Automatic translation enabled"
msgstr "Automaattinen käännös käytössä"

#. Translators: message presented to announce that automatic translation is disabled.
#: addon\globalPlugins\instantTranslate\__init__.py:392
msgid "Automatic translation disabled"
msgstr "Automaattinen käännös pois käytöstä"

#: addon\globalPlugins\instantTranslate\donate_dialog.py:30
msgid "Donate via Paypal"
msgstr "Lahjoita PayPalilla"

#: addon\globalPlugins\instantTranslate\donate_dialog.py:31
msgid "Donate via Yoomoney"
msgstr "Lahjoita Yoomoneylla"

#: addon\globalPlugins\instantTranslate\donate_dialog.py:46
#, python-brace-format
msgid "Request for contributions to {name}"
msgstr "Avustuspyyntö {name}-lisäosalle"

#: addon\globalPlugins\instantTranslate\donate_dialog.py:47
#, python-brace-format
msgid ""
"{name} is a free add-on for NVDA.\n"
"You can make a donation to its author to support further development of this "
"and other free projects.\n"
"Do you want to donate now? Choose one of the available payment methods. You "
"will be redirected to the corresponding website to complete a donation"
msgstr ""
"{name} on ilmainen lisäosa NVDA:lle.\n"
"Voit tehdä lahjoituksen tekijälle tukeaksesi tämän ja muiden ilmaisten "
"projektien jatkokehitystä.\n"
"Haluatko lahjoittaa nyt? Valitse jokin käytettävissä olevista "
"maksuvaihtoehdoista, jonka jälkeen sinut uudelleenohjataan kyseisen palvelun "
"sivustolle lahjoituksen tekemistä varten."

#. Translators: name of the dialog.
#: addon\globalPlugins\instantTranslate\interface.py:23
msgid "Instant Translate"
msgstr "Pikakääntäjä"

#. Translators: Help message for a dialog.
#: addon\globalPlugins\instantTranslate\interface.py:29
msgid "Select translation source and target language:"
msgstr "Valitse käännöksen lähde- ja kohdekieli:"

#. Translators: A setting in addon settings dialog.
#: addon\globalPlugins\instantTranslate\interface.py:33
msgid "Source language:"
msgstr "Lähdekieli:"

#. Translators: A setting in addon settings dialog.
#: addon\globalPlugins\instantTranslate\interface.py:42
msgid "Target language:"
msgstr "Kohdekieli:"

#. Translators: A setting in addon settings dialog, shown if source language is on auto.
#: addon\globalPlugins\instantTranslate\interface.py:48
msgid "Language for swapping:"
msgstr "Vaihdettava kieli:"

#. Translators: A setting in addon settings dialog, shown if source language is on auto.
#: addon\globalPlugins\instantTranslate\interface.py:53
msgid ""
"Activate the auto-swap if recognized source is equal to the target "
"(experimental)"
msgstr ""
"Ota automaattinen kielen vaihto käyttöön, jos lähdekieli on sama kuin "
"kohdekieli (kokeellinen)"

#. Translators: A setting in addon settings dialog.
#: addon\globalPlugins\instantTranslate\interface.py:57
msgid "Copy translation result to clipboard"
msgstr "Kopioi käännös leikepöydälle"

#. Translators: A setting in addon settings dialog.
#: addon\globalPlugins\instantTranslate\interface.py:61
msgid ""
"Replace underscores with spaces (May provide better translation results "
"depending on context)"
msgstr ""
"Korvaa alaviivat välilyönneillä (saattaa tarjota kontekstista riippuen "
"parempia käännöksiä)"

#. Translators: A setting in addon settings dialog.
#: addon\globalPlugins\instantTranslate\interface.py:64
